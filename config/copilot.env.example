# Local copilot configuration template.
# Copy values into this file or set User environment variables.
# Never commit real keys. The installer will not copy secrets from another machine.

# Required for Astra reasoning. Not required to finish local runtime install.
COPILOT_REASONING_API_KEY=
# Alternative:
# OPENAI_API_KEY=

COPILOT_REASONING_BASE_URL=https://api.openai.com/v1
COPILOT_REASONING_MODEL=gpt-6-astra
COPILOT_REASONING_EFFORT=high
